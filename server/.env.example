# App
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wtvr
DB_USER=wtvr_app_user
DB_PASSWORD=change_me_strong_password
DB_CONNECTION_LIMIT=10

# Bootstrap (used by `npm run db:setup` only). Needs CREATE DATABASE / CREATE USER privileges.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# Auth
BCRYPT_COST=12
SESSION_COOKIE_NAME=wtvr_sid
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=8

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Predefined seed accounts (used by `npm run db:seed`).
# Change these before first run; the seeder will refuse weak defaults in production.
SEED_ADMIN_EMAIL=admin@wtvr.local
SEED_ADMIN_PASSWORD=Adm1n!ChangeMe
SEED_AUTHOR_EMAIL=author@wtvr.local
SEED_AUTHOR_PASSWORD=Auth0r!ChangeMe
SEED_READER_EMAIL=reader@wtvr.local
SEED_READER_PASSWORD=R3ader!ChangeMe
